# Copia este archivo a .env y ajusta según tu entorno.

# --- Conexión al Servidor Homelab (para sync.sh, run_app.sh y run_ui_local.sh) ---
RAG_REMOTE_HOST=192.168.80.85
RAG_REMOTE_USER=homelab
# RAG_REMOTE_DEST=~/rag-data/
# RAG_REMOTE_REPO=~/Code/RAG

# --- Parámetros de Configuración del RAG (en homelab o local) ---
RAG_SOURCE_DIR=~/rag-data
COCOINDEX_DB=./.cocoindex_db
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=rag_docs
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:7b
SCORE_THRESHOLD=0.58
