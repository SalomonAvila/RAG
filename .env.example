# Copia este archivo a .env y ajusta según tu entorno.

# --- Conexión al Servidor Homelab (para sync.sh, run_app.sh y run_ui_local.sh) ---
# Equipo donde corren Qdrant y Ollama (IP o nombre) y tu usuario SSH en él
RAG_REMOTE_HOST=192.168.1.100
RAG_REMOTE_USER=usuario
# Carpeta local que sync.sh envía al servidor
# RAG_LOCAL_DIR=${HOME}/Documentos/rag
# Rutas en el servidor: entre comillas simples para que "~" se expanda allá, no aquí
# RAG_REMOTE_DEST='~/rag-data/'
# RAG_REMOTE_REPO='~/RAG'
# 1 = los scripts hacen "git pull --ff-only" antes de arrancar (aquí y en el servidor)
# RAG_AUTO_UPDATE=0

# --- Parámetros de Configuración del RAG (en homelab o local) ---
RAG_SOURCE_DIR=~/rag-data
COCOINDEX_DB=./.cocoindex_db
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=rag_docs
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:7b
# LLM_NUM_CTX=8192
# OLLAMA_KEEP_ALIVE=30m
# EMBED_NUM_GPU=0
# NOISE_FLOOR=0.64
# RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8   # vacío = sin reranker
# RERANK_CANDIDATES=8
# RERANK_KEEP_RATIO=0.25
# RERANK_MIN_KEEP=3
# RERANK_MIN_SCORE=0.05
# ROUTE_PENALTY=0.25
