# Copia este archivo a .env y ajusta según dónde corras el cliente.

# --- En el Servidor Homelab (Valores por defecto) ---
RAG_SOURCE_DIR=~/rag-data
COCOINDEX_DB=./.cocoindex_db
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=rag_docs
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:3b

# --- Si corres la UI o consultas desde tu PC portátil hacia el Homelab ---
# (Descomenta y ajusta con la IP de tu servidor si te conectas directo por LAN,
# o déjalo en localhost si usas un túnel SSH port-forwarding):
# QDRANT_URL=http://<IP-HOMELAB>:6334
# OLLAMA_URL=http://<IP-HOMELAB>:11434
