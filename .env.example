# Copia este archivo a .env y ajusta lo que necesites. Todos tienen valores por defecto.

# Carpeta con lo que se va a indexar (repos, apuntes de clase, PDFs...)
RAG_SOURCE_DIR=~/rag-data

# Estado interno de CocoIndex (para la indexación incremental)
COCOINDEX_DB=./.cocoindex_db

# Servicios
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=rag_docs
OLLAMA_URL=http://localhost:11434

# Modelos de Ollama
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:3b
